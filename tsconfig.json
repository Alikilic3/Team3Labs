    "target": "ES2020",
    "module": "ES2020",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "rootDir": "./src",
    "outDir": "./js",
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["src/server.ts"]
