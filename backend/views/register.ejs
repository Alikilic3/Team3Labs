<!doctype html>
<html lang="nl">
<%- include('partials/head', { title: 'team3Labs - Registreren', extraCss: 'register.css' }) %>
<body>
<%- include('partials/header', { activePage: 'register' }) %>

<main class="content-wrapper auth-page">
    <div class="auth-card">
        <h1 class="page-title">Account Aanmaken</h1>
        <p class="page-subtitle">Word lid van team3Labs</p>
        
        <p id="errorMsg" style="color: red; display: none; font-weight: bold;"></p>
        
        <form id="registerForm">
            <div class="form-group">
                <label for="username">Gebruikersnaam:</label>
                <input type="text" id="username" name="username" placeholder="Kies een unieke naam" required>
                
                <label for="email">E-mailadres:</label>
                <input type="email" id="email" name="email" placeholder="naam@email.com" required>
                
                <label for="telefoon">Telefoonnummer:</label>
                <input type="tel" id="telefoon" name="telefoon" placeholder="Bijv. 0470123456" pattern="[0-9]+" title="Vul enkel cijfers in" required>
                
                <label for="password">Wachtwoord:</label>
                <input type="password" id="password" name="password" placeholder="Minimaal 5 tekens" minlength="5" required>
                
                <label for="password-confirm">Bevestig Wachtwoord:</label>
                <input type="password" id="password-confirm" name="password-confirm" placeholder="Typ je wachtwoord opnieuw" required>
            </div>
            <button type="submit" class="btn btn-primary btn-full">Registreren</button>
        </form>
        
        <div class="auth-footer">
            <p>Heb je al een account? <a href="/login" class="text-link">Log hier in</a></p>
        </div>
    </div>
</main>

<script src="/js/register.js"></script>
</body>
</html>