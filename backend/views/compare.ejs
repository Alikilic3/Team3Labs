<!doctype html>
<html lang="nl">
<%- include('partials/head', { title: 'Vergelijken - Team3Labs', extraCss: 'compare.css' }) %>
<body>
<%- include('partials/header-app', { activePage: 'compare' }) %>

<main class="content-wrapper app-content">
    <section class="vergelijk-intro">
        <h1 class="page-title">Games Vergelijken</h1>
        <p>Kies twee games om hun statistieken zij-aan-zij te vergelijken.</p>
    </section>

    <section class="compare-search-area">
        <div class="search-box-container">
            <input type="text" id="searchInput1" class="search-input" placeholder="Game 1 (bijv. GTA V)..." autocomplete="off">
        </div>
        
        <div class="vs-badge">VS</div>
        
        <div class="search-box-container">
            <input type="text" id="searchInput2" class="search-input" placeholder="Game 2 (bijv. RDR 2)..." autocomplete="off">
        </div>
        
        <div class="compare-actions">
            <button id="compareBtn" class="btn btn-primary compare-btn"><i class="bi bi-bar-chart-fill"></i> Vergelijk</button>
            <button id="resetBtn" class="btn btn-outline reset-btn"><i class="bi bi-arrow-counterclockwise"></i> Reset</button>
        </div>
    </section>

    <section class="results-section">
        <div id="defaultGamesArea" class="default-games-container">
            <h2 id="gridTitle"><i class="bi bi-fire text-danger"></i> Populaire Games in 2025</h2>
            <div id="topGamesGrid"></div>
        </div>

        <div class="compare-results-area" id="compareResults" aria-live="polite"></div>
    </section>
</main>

<div id="gameModal" class="game-modal hidden">
    <div class="game-modal-content">
        <button id="closeModal" class="close-modal">&times;</button>
        <div id="modalBody"></div>
    </div>
</div>

<script src="/js/comparePage.js"></script>
<script src="/js/main.js"></script>
<%- include('partials/footer') %>
</body>
</html>