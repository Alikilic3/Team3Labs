<!doctype html>
<html lang="nl">
<%- include('partials/head', { title: 'Team3Labs - Introductie', extraCss: 'intro.css' }) %>
<body>
<%- include('partials/header', { activePage: 'intro' }) %>

<main class="content-wrapper">
    <div class="instructions-container">
        <h1 class="page-title">Welkom bij Team3Labs</h1>
        <p class="page-subtitle">Hier vind je een korte handleiding over het gebruik van onze applicaties.</p>

        <section class="instruction-step">
            <div class="step-number">1</div>
            <div class="step-text">
                <h2>Maak een account aan</h2>
                <p>Om volledige toegang te krijgen tot alle functies, raden we je aan om eerst te <a href="/register" class="text-link">registreren</a> en in te loggen.</p>
            </div>
        </section>

        <section class="instruction-step">
            <div class="step-number">2</div>
            <div class="step-text">
                <h2>Kies je project</h2>
                <p>Ga naar de <a href="/" class="text-link">Projecten</a> pagina.</p>
            </div>
        </section>

        <section class="instruction-step">
            <div class="step-number">3</div>
            <div class="step-text">
                <h2>Gebruik GameHub</h2>
                <p>In de GameHub kun je zoeken op titels van videogames, filteren op genre en de nieuwste releases bekijken.</p>
            </div>
        </section>

        <div class="action-box">
            <p>Klaar om te beginnen?</p>
            <a href="/" class="btn btn-primary">Ga naar Projecten</a>
        </div>
    </div>
</main>

<%- include('partials/footer') %>