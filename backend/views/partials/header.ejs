<header class="main-header">
  <a href="/" class="logo">Team3Labs</a>

  <nav class="main-nav">
    <ul>
      <li><a href="/" class="<%= activePage === 'index' ? 'active' : '' %>">Projecten</a></li>
      <li><a href="/intro" class="<%= activePage === 'intro' ? 'active' : '' %>">Introductie</a></li>
    </ul>
  </nav>

  <div class="auth-buttons">
    <a href="/login" class="btn btn-outline <%= activePage === 'login' ? 'active' : '' %>">Login</a>
