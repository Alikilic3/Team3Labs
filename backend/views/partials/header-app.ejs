<header class="main-header app-header">
    <div class="header-left">
        <a href="/search" class="logo">Team3Labs</a>

        <button class="hamburger" id="hamburgerBtn" aria-label="Menu openen">
            <span></span>
            <span></span>
            <span></span>
        </button>

        <nav class="main-nav" id="mainNav">
            <ul>
                <li><a href="/search" class="<%= activePage === 'search' ? 'active' : '' %>">Zoeken</a></li>
                <li><a href="/collection" class="<%= activePage === 'collection' ? 'active' : '' %>">Mijn Collectie</a></li>
                <li><a href="/compare" class="<%= activePage === 'compare' ? 'active' : '' %>">Vergelijken</a></li>
                <li><a href="/guess" class="<%= activePage === 'guess' ? 'active' : '' %>">Guess Game</a></li>
            </ul>
        </nav>
    </div>

    <div class="header-right">
        <div class="current-game-badge">
            <span class="badge-label">Huidige Game:</span>
            <span class="badge-title" id="headerCurrentGame">
                <% if (user.currentGame) { %>
                    <%= user.currentGame.name %>
                <% } else { %>
                    Geen gekozen
                <% } %>
            </span>
        </div>

        <div class="user-menu">
            <span class="user-avatar" title="<%= user.name %>"><%= user.name.charAt(0).toUpperCase() %></span>
            <form action="/logout" method="POST" style="display:inline">
                <button type="submit" class="btn btn-outline btn-small">Uitloggen</button>
            </form>
        </div>
    </div>
</header>