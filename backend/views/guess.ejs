<!doctype html>
<html lang="nl">
<%- include('partials/head', { title: 'Guess - GameHub', extraCss: 'guess.css' }) %>
<body>
<%- include('partials/header-app', { activePage: 'guess' }) %>

<main class="content-wrapper app-content">
    <section class="guess-section">
        <h1 class="page-title">Raad de game</h1>

        <div class="guess-container">

            <div class="stats">
                <div class="stat-box"><i class="bi bi-star-fill"></i> XP: <span id="xp">0</span></div>
                <div class="stat-box"><i class="bi bi-controller"></i> Ronde: <span id="round">0</span>/5</div>
                <div class="stat-box"><i class="bi bi-heart-fill"></i> Pogingen: <span id="attempts-display">○○○○○</span></div>
            </div>

            <div class="guess-controls">
                <button id="startBtn" class="btn btn-primary">
                    <i class="bi bi-play-fill"></i> Start
                </button>
                <button id="resetBtn" class="btn btn-outline" disabled>
                    <i class="bi bi-arrow-counterclockwise"></i> Reset
                </button>
            </div>

            <div class="guess-image-container" id="imageContainer">
                <div class="guess-placeholder" id="placeholder">
                    <i class="bi bi-controller"></i>
                    <p>Druk op Start om te beginnen!</p>
                </div>
                <div class="guess-image-wrapper">
                    <img id="blurredImage" src="" alt="Guess Image" style="display:none;">
                    <button class="hint-btn" id="hintBtn" style="display:none;" title="Hint">
                        <i class="bi bi-info-circle-fill"></i>
                    </button>
                </div>
                <div class="hint-box" id="hintBox" style="display:none;"></div>
            </div>

            <div class="guess-input-container" id="inputContainer" style="display:none;">
                <input type="text" id="guessInput" class="search-input" placeholder="Typ de naam van de game..." autocomplete="off">
                <button id="checkBtn" class="btn btn-primary">
                    <i class="bi bi-check-lg"></i> Check
                </button>
            </div>

            <p id="feedback" class="guess-feedback"></p>

        </div>
        <div class="scoreboard" id="scoreboard" style="display:none;">
            <h2><i class="bi bi-trophy-fill"></i> Top 10 Scorebord</h2>
            <ol id="scoreboardList"></ol>
            <button id="playAgainBtn" class="btn btn-primary">
                <i class="bi bi-play-fill"></i> Opnieuw spelen
            </button>
        </div>

    </section>
</main>

<script>
    const SESSION_USER_ID = "<%= userId %>";
</script>
<script src="/js/main.js"></script>
<script src="/js/script.js"></script>
<%- include('partials/footer') %>